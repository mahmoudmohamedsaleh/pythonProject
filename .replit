modules = ["web", "python-3.12", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "geckodriver", "gitFull", "glibcLocales", "playwright-driver", "xcodebuild", "zlib"]

[workflows]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["python3", "app.py"]
