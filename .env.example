# ============================================================
# EJTech CRM — Required Environment Variables
# Copy this file to .env for local development.
# On GCP Cloud Run, set these as Secret Manager secrets or
# environment variables in the Cloud Run service configuration.
# ============================================================

# ----- Database -----
# For Cloud Run + Cloud SQL via Unix socket (recommended):
#   postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# For Cloud Run + Cloud SQL via Public IP (with SSL):
#   postgresql://USER:PASSWORD@PUBLIC_IP/DBNAME
# For local development against Replit DB (copy from Replit Secrets panel):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----- Flask -----
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
FLASK_ENV=production

# ----- OpenAI (used for AI Executive Summary in quotation PPTX) -----
OPENAI_API_KEY=sk-...

# ----- Resend (used for OTP email and follow-up reminders) -----
RESEND_API_KEY=re_...

# ----- Optional: override port (Cloud Run sets PORT=8080 automatically) -----
# PORT=8080
